# =========================================================
# PERSO Inbound Console — environment variables
# Copy this file to `.env` and fill in. .env is gitignored.
# =========================================================

# ----- LLM: Gemini on Vertex AI (the only provider) -----
# Authenticated with a service-account JSON — no API key.
# Hybrid tiers: GEMINI_MODEL = fast/cheap "flash" for classification/scoring/routing;
#               GEMINI_MODEL_PRO = high-quality "pro" for customer-facing drafting.
GEMINI_MODEL=gemini-2.5-flash             # flash tier (light judgment)
GEMINI_MODEL_PRO=gemini-2.5-pro           # pro tier (reply/email drafting)
# Paste the FULL service-account JSON as a single line (escape inner quotes or wrap in single quotes).
GOOGLE_CREDENTIALS_JSON=
# optional; falls back to project_id inside the JSON
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global               # e.g. global, us-central1, asia-northeast1

# ----- Google Sheets synchronization (사용자 OAuth 전용) -----
# 조직 정책상 서비스 계정 공유가 막혀 있어 사용자 OAuth로만 연결합니다.
# OAuth 클라이언트는 아래 웹 로그인용 GOOGLE_OAUTH_CLIENT_ID/_SECRET 를 그대로 씁니다.
# 별도 Sheets 클라이언트는 없습니다 — 그 클라이언트에 spreadsheets 스코프만 추가하세요.
# 승인 URI(아래 CLI 전용): http://127.0.0.1:8000/integrations/google-sheets/callback
# 시트 소유자 본인 계정의 refresh token. 채워 두면 /pipeline 의 "내 Google 계정 연결"
# 버튼을 누를 필요가 없어집니다 — 재배포하거나 DB를 날려도 그대로 붙습니다.
#   발급(최초 1회):  python scripts/connect_google_sheets.py
# 비밀번호와 동급으로 취급하세요. 비워 두면 기존 브라우저 연결 방식으로 동작합니다.
GOOGLE_SHEETS_OAUTH_REFRESH_TOKEN=
# 표시용: 위 토큰이 누구 계정인지 (/pipeline 패널에 그대로 보입니다)
GOOGLE_SHEETS_ACCOUNT_EMAIL=
# 대상 워크북. 비우면 config.py 의 현재 워크북 기본값을 씁니다.
# 시트를 바꾸려면 여기만 고치세요 — URL 의 /d/ 와 /edit 사이 부분입니다.
# 위 REFRESH_TOKEN 과 혼동 금지: 그건 계정 인증용(1// 로 시작)입니다.
GOOGLE_SHEETS_SPREADSHEET_ID=
# 탭 이름이 워크북마다 다르면 여기서 덮어씁니다. QUALITY 는 참고용이라 비워도 됩니다.
GOOGLE_SHEETS_INBOUND_TAB=
GOOGLE_SHEETS_QUALITY_TAB=
GOOGLE_SHEETS_ORDERS_TAB=

# ----- Notion (정책 문서) -----
# 플랜·가격·CS 정책은 노션에서 관리하고, 이 앱은 읽기만 해서 사본을 보관합니다.
# 내부 통합 시크릿: https://app.notion.com/developers/connections → New integration
# (Type=Internal, Capabilities는 Read content만). 만든 뒤 각 정책 페이지에서
# ··· → 연결(Connections)로 그 통합을 추가해야 읽힙니다 — 안 하면 404입니다.
# 비어 있으면 동기화만 건너뛰고 마지막 사본으로 답변은 계속 만들어집니다.
NOTION_TOKEN=
# 이 워크스페이스에서는 위 토큰을 만들 수 없어서 비어 있습니다. 그동안 대안이었던 쿠키
# 방식(NOTION_TOKEN_V2 / NOTION_FILE_TOKEN / NOTION_ACTIVE_USER_ID)과 Export zip 업로드는
# 지웠습니다 — 그 내보내기가 실어 오는 것이 부모 페이지 하나뿐이었습니다.
# 지금은 콘솔에 본문을 붙여넣습니다: docs/정책문서-동기화-설계.md
# 브라우저 연결 방식에서만 쓰는 refresh token 암호화 키(랜덤 긴 문자열, 별도 보관).
# 위 REFRESH_TOKEN 을 쓰면 DB에 저장할 것이 없으므로 필요하지 않습니다.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ----- HubSpot ("Perso Dubbing Sales Agent" Private App) -----
# Private App access token (pat-na1-...)
HUBSPOT_ACCESS_TOKEN=
# 웹훅 v3 서명 검증용 Client secret (App → Auth 탭)
HUBSPOT_WEBHOOK_SECRET=
# optional: 생성 레코드 기본 담당자
HUBSPOT_OWNER_ID=
# [B2B] AI Dubbing 파이프라인(798618015) stage ID. 이름은 HubSpot 스테이지 라벨과 일치시킵니다.
# NEW = 웹훅이 "신규 유입"으로 처리하는 기준. id 확인: scripts/list_ticket_stages.py
# 보드 컬럼도 이 7개가 전부이고 순서까지 동일합니다 (PIPELINE_STAGES).
# **일곱 개를 다 채우세요.** id 가 빈 단계는 stage_id_to_local() 이 건너뛰므로, HubSpot 에서
# 그 단계로 옮긴 티켓이 콘솔에 안 보이고(초안도 안 닫힙니다), 콘솔에서 그 열로 옮기면
# HubSpot 이 안 따라오는데 배너는 "시도 안 함" 으로 처리해 아무 말도 하지 않습니다.
HUBSPOT_TICKET_STAGE_NEW=1172180243                 # New
HUBSPOT_TICKET_STAGE_QUALIFIED=1193842435           # Qualified (구 Meeting Link Sent, 답변 발송 후 이동)
HUBSPOT_TICKET_STAGE_NEGOTIATING=1193733925         # Negotiating
HUBSPOT_TICKET_STAGE_REMINDER_SENT=1196621584       # Reminder Sent
HUBSPOT_TICKET_STAGE_WON=1196772135                 # Won
HUBSPOT_TICKET_STAGE_LOST=1172180246                # Lost
HUBSPOT_TICKET_STAGE_NOT_A_FIT=1404814097           # Not a Fit (구 Closed, 그 전 Unqualified)
# 단계는 id 를 그대로 둔 채 이름만 바뀝니다. 구버전 이름(MEETING_LINK_SENT / AFTER_SEND /
# NEGOTIATION / CLOSED_LOST / CLOSED / UNQUALIFIED)도 그대로 인식됩니다.
# FOLLOW_UP_NEEDED / CONTRACTED / ONBOARDING / ACTIVE 는 마이그레이션 0040 에서 폐기됐습니다.
HUBSPOT_UPDATE_CONTACT_INBOUND_STATUS=false  # 커스텀 inbound_status 속성이 있을 때만 true

# ----- Email sending (SMTP) -----
# SMTP가 실제 메일을 보내고, 성공 후 HubSpot 타임라인에 이메일 활동을 기록합니다.
# 기본값은 Gmail(무료 500통/일, 2단계 인증 + 앱 비밀번호 필요).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail App Password, not your account password
SMTP_PASSWORD=
SMTP_FROM_NAME=Sales Team
SMTP_FROM_EMAIL=
# 다른 provider: Outlook(smtp-mail.outlook.com), Brevo(smtp-relay.brevo.com),
# SendGrid(smtp.sendgrid.net, USERNAME=apikey) — HOST/USERNAME/PASSWORD만 교체.

# ----- 출시 전 안전 스위치 (최우선 대전제) -----
# false(기본, SAFE): 실제 HubSpot에 어떤 쓰기도 하지 않고(티켓 단계/컨택/타임라인),
# Google Sheet 쓰기도 막고, 모든 이메일을 ronald@estsoft.com 으로 강제 전송합니다
# (SEND_OVERRIDE_EMAIL 이 비어 있어도 고객에겐 절대 발송되지 않음). 읽기는 정상 동작.
# 실서비스 시작 시에만 true 로 바꾸고, 동시에 SEND_OVERRIDE_EMAIL 을 비우세요.
LIVE_EXTERNAL_WRITES=false
# 마스터가 true 일 때만 읽히는 목적지별 스위치 (기본 true). 한쪽 먼저 열기용:
#   LIVE_HUBSPOT_WRITES=false → 시트만 동기화, HubSpot 티켓/컨택은 그대로 둠
#   LIVE_SHEETS_WRITES=false  → HubSpot 만 반영, 워크북은 읽기 전용 유지
# 마스터가 false 면 둘 다 무시되고 전부 차단됩니다 — 안전 여부는 마스터 하나만 보면 됩니다.
LIVE_HUBSPOT_WRITES=true
LIVE_SHEETS_WRITES=true

# ----- 테스트 모드: 모든 실제 발송을 한 주소로 리다이렉트 -----
# 값이 있으면 모든 고객 대상 이메일이 이 주소로 SMTP를 통해 발송되고, 실제 HubSpot
# 컨택 타임라인에 흔적이 남지 않습니다. 원래 수신자는 제목에 "[TEST→원래주소]"로
# 보존됩니다. SMTP_USERNAME/PASSWORD 설정 필요. 운영 시 반드시 비워두세요.
SEND_OVERRIDE_EMAIL=

# ----- Slack (for human approval) -----
SLACK_ENABLED=false                         # 전체 Slack 발송 스위치
APPROVAL_CHANNEL=none                        # slack 로 바꾼 경우에도 초안당 1회만 알림
SLACK_BOT_TOKEN=
# AI 답변 초안이 준비됐을 때만 알림
SLACK_APPROVAL_CHANNEL_ID=

# ----- Web UI access (공개 배포 시 필수) -----
# 웹 UI(승인/수정/지식편집)는 자체 인증이 없어 기본은 localhost 전용.
# 공개 배포(Render 등)에서 쓰려면 WEB_UI_PASSWORD 설정 → 브라우저 Basic Auth 로그인.
# 비우면 localhost 전용 유지(로컬 개발).
WEB_UI_USERNAME=admin
# 강한 비밀번호 설정 (공개 URL에서 웹 UI 접근용)
WEB_UI_PASSWORD=

# ----- Web UI 로그인 방식 -----
# basic         : 위 Basic Auth(또는 localhost). 기본값.
# google_oauth  : 구글 로그인 — ALLOWED_EMAIL_DOMAIN 도메인 + 아래 allowlist만 허용.
# 구글 자격증명을 채우기 전까지 basic 유지(배포 잠김 방지).
AUTH_MODE=basic
# Google Cloud → OAuth 2.0 웹 클라이언트 ID
GOOGLE_OAUTH_CLIENT_ID=
# 같은 클라이언트의 시크릿
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=estsoft.com             # 이 도메인의 인증된 구글 계정만 로그인
# 운영자 계정은 DB(users 테이블 · /settings/users)에서만 관리합니다. env 허용목록은 없습니다.
# 테이블이 비어 있을 때 첫 로그인이 관리자로 부트스트랩되고, 복구는 scripts/bootstrap_admin.py.
# 세션 쿠키·OAuth state 서명 키(랜덤 긴 문자열). OAuth 사용 시 필수
SESSION_SECRET=
# 리디렉트 URI는 https://<배포URL>/auth/callback 를 Google 콘솔에 등록하세요.

# ----- Report distribution (email only; Slack is reply-ready alerts only) -----
# comma-separated list, e.g. boss@co.com,team@co.com
REPORT_EMAIL_TO=

# ----- Inbound poller (webhook 누락 방지 fallback) -----
INBOUND_POLL_ENABLED=true                    # 10분마다 HubSpot New Ticket 폴링 (webhook 백업)
INBOUND_POLL_INTERVAL_SECONDS=600            # 폴링 간격 (초)
INBOUND_INITIAL_LOOKBACK_HOURS=24             # 첫 실행 시 과거 문의 복구 범위
INBOUND_WORKER_ENABLED=true                   # 영속 큐 처리 및 자동 재시도

# ----- Send worker (background queue) -----
SEND_WORKER_ENABLED=true                     # 승인 후 동일 워커 경로로 발송
SEND_RATE_PER_MINUTE=5                       # 분당 최대 발송 건수
DAILY_SEND_LIMIT=400                         # 일일 최대 발송 건수 (0=무제한)
SEND_JITTER_SECONDS=15                       # 메일 사이 0~N초 랜덤 대기


# ----- Deployment / security (secure defaults; override only if needed) -----
# 배포 URL. 승인 링크·OAuth 리다이렉트 기준 (프로덕션 필수)
PUBLIC_BASE_URL=
# X-Forwarded-For 를 신뢰할 프록시 IP(쉼표구분). 비우면 헤더 무시
TRUSTED_PROXIES=
HUBSPOT_WEBHOOK_REQUIRE_SIGNATURE=true       # true=서명 없는 웹훅 거부(fail-closed). 시크릿 미설정 시 503

# ----- Domain enrichment (인바운드 이메일 도메인 자동 분석) -----
INBOUND_DOMAIN_ENRICHMENT_ENABLED=true      # 인바운드 시 회사 도메인 자동 분석
INBOUND_DOMAIN_HOMEPAGE_FETCH=true           # false 면 홈페이지 fetch 생략, LLM-only 분석
INBOUND_DOMAIN_FETCH_TIMEOUT_SECONDS=8.0     # 홈페이지 GET 타임아웃 (초)
INBOUND_DOMAIN_REANALYZE_DAYS=90             # 이 일수 이상 오래된 프로파일 자동 재분석 후보

# ----- DB -----
DATABASE_URL=sqlite:///./data/app.db

# ----- App -----
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_CONCURRENCY=1                         # in-process poll/send workers require one web process
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
# 필수: 강한 랜덤 값으로 설정 (`python -c "import secrets; print(secrets.token_urlsafe(32))"`). 비어 있으면 API가 모든 요청을 거부합니다.
INTERNAL_API_TOKEN=
