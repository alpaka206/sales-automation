# =========================================================
# Sales Automation — environment variables
# Copy this file to `.env` and fill in. .env is gitignored.
# =========================================================

# ----- LLM (one of: claude_cli | anthropic_api) -----
LLM_PROVIDER=claude_cli
# CLI mode — uses `claude -p` subprocess. No API key needed.
# CLAUDE_CLI_PATH=claude                  # override if `claude` is not on PATH

# API mode (optional, used when LLM_PROVIDER=anthropic_api)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- HubSpot -----
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_INBOUND_PIPELINE_ID=                # optional: which deal pipeline new inbound goes into
HUBSPOT_OWNER_ID=                           # optional: default owner for created records

# ----- Email sending (one of: hubspot | smtp) -----
EMAIL_PROVIDER=hubspot

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                              # Gmail App Password, not your account password
SMTP_FROM_NAME=Sales Team
SMTP_FROM_EMAIL=

# ----- WhatsApp (off by default) -----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ----- Slack / Teams (for human approval) -----
APPROVAL_CHANNEL=slack                       # slack | teams | none
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL_ID=
SLACK_ERROR_CHANNEL_ID=                      # n8n error alerts; falls back to SLACK_APPROVAL_CHANNEL_ID
TEAMS_WEBHOOK_URL=

# ----- Report distribution -----
REPORT_SLACK_CHANNEL_ID=                     # separate from approval channel; falls back to SLACK_APPROVAL_CHANNEL_ID
REPORT_EMAIL_TO=                             # comma-separated list, e.g. boss@co.com,team@co.com

# ----- Outbound sources -----
YOUTUBE_API_KEY=
LINKEDIN_ENABLED=false                       # keep false; we do NOT scrape LinkedIn
LINKEDIN_SCRAPING_ENABLED=false              # linkedin_comments source; operator responsibility for ToS compliance
LINKEDIN_SESSION_COOKIE=                     # li_at cookie from a logged-in browser session (for Playwright scraping)
LINKEDIN_API_TOKEN=                          # partner-tier LinkedIn API token (if available; takes priority over Playwright)

# ----- Behavior knobs -----
AUTO_SEND_THRESHOLD=1.01                     # >1.0 means: never auto-send, always require human approval
OUTBOUND_COOLDOWN_DAYS=90
FOLLOWUP_AFTER_DAYS=4
ICP_THRESHOLD=50                             # minimum ICP score to consider a prospect worth outreach
DAILY_REPORT_HOUR=18                         # 24h clock, local time
WEEKLY_REPORT_DOW=5                          # 0=Mon, 5=Sat

# ----- DB -----
DATABASE_URL=sqlite:///./data/app.db

# ----- App -----
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
INTERNAL_API_TOKEN=                            # 필수: 강한 랜덤 값으로 설정 (`python -c "import secrets; print(secrets.token_urlsafe(32))"`). 비어 있으면 API가 모든 요청을 거부합니다.
