{
  "name": "02 Outbound Cron",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] } },
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BE_BASE_URL }}/run/outbound",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "source", "value": "manual_csv" },
            { "name": "filters", "value": "{}" }
          ]
        }
      },
      "name": "Run Outbound manual_csv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.BE_BASE_URL }}/run/outbound",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "source", "value": "youtube" },
            { "name": "filters", "value": "{\"query\": \"SaaS Korea\"}" }
          ]
        }
      },
      "name": "Run Outbound youtube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 400]
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [
        [
          { "node": "Run Outbound manual_csv", "type": "main", "index": 0 },
          { "node": "Run Outbound youtube", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
