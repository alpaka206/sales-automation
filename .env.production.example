# =========================================================
# Sales Automation — production environment variables
# Set these in your PaaS dashboard (Render, Railway, Fly.io)
# or copy to `.env` for self-hosted deploy.
# =========================================================

# ----- LLM: Gemini on Vertex AI (service-account JSON, no API key) -----
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_CLOUD_PROJECT=                       # optional; falls back to JSON project_id
GOOGLE_CLOUD_LOCATION=global

# ----- HubSpot -----
HUBSPOT_PRIVATE_APP_TOKEN=pat-...
HUBSPOT_INBOUND_PIPELINE_ID=
HUBSPOT_OWNER_ID=

# ----- Email -----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=Sales Team
SMTP_FROM_EMAIL=your-email@gmail.com

# ----- WhatsApp -----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ----- Approval -----
APPROVAL_CHANNEL=slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APPROVAL_CHANNEL_ID=C...
TEAMS_WEBHOOK_URL=

# ----- Reports -----
REPORT_SLACK_CHANNEL_ID=
REPORT_EMAIL_TO=

# ----- Sources -----
YOUTUBE_API_KEY=
LINKEDIN_ENABLED=false

# ----- Behavior -----
AUTO_SEND_THRESHOLD=1.01
OUTBOUND_COOLDOWN_DAYS=90
FOLLOWUP_AFTER_DAYS=4
ICP_THRESHOLD=50
DAILY_REPORT_HOUR=18
WEEKLY_REPORT_DOW=5

# ----- DB -----
DATABASE_URL=sqlite:///./data/app.db

# ----- App -----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=WARNING
TIMEZONE=Asia/Seoul
INTERNAL_API_TOKEN=CHANGE-ME-TO-RANDOM-STRING
