{
  "name": "02 Outbound Cron",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] } },
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BE_BASE_URL }}/run/outbound",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "source", "value": "manual_csv" },
            { "name": "filters", "value": "{}" }
          ]
        },
        "options": {}
      },
      "name": "Run Outbound manual_csv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "url": "={{ $env.BE_BASE_URL }}/run/outbound",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "source", "value": "youtube" },
            { "name": "filters", "value": "{\"query\": \"SaaS Korea\"}" }
          ]
        },
        "options": {}
      },
      "name": "Run Outbound youtube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 400],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_ERROR_CHANNEL_ID || $env.SLACK_APPROVAL_CHANNEL_ID }}",
        "text": "[02 Outbound Cron] 오류 발생: {{ $json.execution.error.message }}",
        "otherOptions": {}
      },
      "name": "Slack Error Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [500, 600],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack" } }
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [
        [
          { "node": "Run Outbound manual_csv", "type": "main", "index": 0 },
          { "node": "Run Outbound youtube", "type": "main", "index": 0 }
        ]
      ]
    },
    "Error Trigger": { "main": [[{ "node": "Slack Error Alert", "type": "main", "index": 0 }]] }
  }
}
