# =========================================================
# PERSO Inbound Console — environment variables
# Copy this file to `.env` and fill in. .env is gitignored.
# =========================================================

# ----- LLM: Gemini on Vertex AI (the only provider) -----
# Authenticated with a service-account JSON — no API key.
# Hybrid tiers: GEMINI_MODEL = fast/cheap "flash" for classification/scoring/routing;
#               GEMINI_MODEL_PRO = high-quality "pro" for customer-facing drafting.
GEMINI_MODEL=gemini-2.5-flash             # flash tier (light judgment)
GEMINI_MODEL_PRO=gemini-2.5-pro           # pro tier (reply/email drafting)
# Paste the FULL service-account JSON as a single line (escape inner quotes or wrap in single quotes).
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT=                      # optional; falls back to project_id inside the JSON
GOOGLE_CLOUD_LOCATION=global               # e.g. global, us-central1, asia-northeast1

# ----- Google Sheets mirror (optional) -----
# Append every processed inbound inquiry to a Google Sheet for at-a-glance tracking.
# Uses a SEPARATE service-account from Vertex. Share the sheet (Editor) with its client email.
GSHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_JSON=            # full JSON of a dedicated Sheets service-account
GOOGLE_SHEETS_SPREADSHEET_ID=             # the long id from the sheet URL /d/<ID>/edit
GOOGLE_SHEETS_INBOUND_TAB=Inbound         # worksheet/tab name to append rows to

# ----- HubSpot -----
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_INBOUND_PIPELINE_ID=                # optional: which deal pipeline new inbound goes into
HUBSPOT_OWNER_ID=                           # optional: default owner for created records
HUBSPOT_WEBHOOK_SECRET=                     # HubSpot webhook 서명 검증 (Settings → Webhooks → Client secret)
HUBSPOT_TICKET_STAGE_NEW=1                  # 현재 개발자 계정: Support Pipeline > New
HUBSPOT_TICKET_STAGE_AFTER_SEND=2           # 현재 개발자 계정 임시값: Waiting on contact
HUBSPOT_UPDATE_CONTACT_INBOUND_STATUS=false # 커스텀 inbound_status 속성이 있을 때만 true
HUBSPOT_WHATSAPP_OPT_IN_PROPERTY=            # 명시적 WhatsApp 동의 여부를 저장한 contact 속성명

# ----- Email sending -----
# SMTP가 실제 메일을 보내고, 성공 후 HubSpot 타임라인에 이메일 활동을 기록합니다.
EMAIL_PROVIDER=smtp

# SMTP (used when EMAIL_PROVIDER=smtp)
# --- Gmail (무료 500통/일, 2단계 인증 필수) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                              # Gmail App Password, not your account password
SMTP_FROM_NAME=Sales Team
SMTP_FROM_EMAIL=
# --- Outlook / Microsoft 365 (무료 300통/일) ---
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@outlook.com
# SMTP_PASSWORD=                            # Outlook 계정 비밀번호 또는 앱 비밀번호
# --- Brevo (구 Sendinblue, 무료 300통/일) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=                            # Brevo 가입 이메일
# SMTP_PASSWORD=                            # Brevo SMTP 키 (Settings > SMTP & API)
# --- SendGrid (무료 100통/일) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey                      # 항상 "apikey" 고정
# SMTP_PASSWORD=                            # SendGrid API Key (Settings > API Keys)

# ----- 테스트 모드: 모든 실제 발송을 한 주소로 리다이렉트 -----
# 값이 있으면 모든 고객 대상 이메일이 이 주소로 SMTP를 통해 발송됩니다.
# 실제 HubSpot 컨택
# 타임라인에 흔적이 남지 않고, WhatsApp 동시 발송도 건너뜁니다. 원래 수신자는
# 제목에 "[TEST→원래주소]"로 보존됩니다. SMTP_USERNAME/PASSWORD 설정 필요.
# 운영 시 반드시 비워두세요.
SEND_OVERRIDE_EMAIL=

# ----- WhatsApp (off by default) -----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=sales_reply_intro   # Meta Business Suite 에서 승인받은 template 이름

# ----- Slack (for human approval) -----
SLACK_ENABLED=false                         # 전체 Slack 발송 스위치
APPROVAL_CHANNEL=none                        # slack 로 바꾼 경우에도 초안당 1회만 알림
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL_ID=                  # AI 답변 초안이 준비됐을 때만 알림

# ----- Web UI access (공개 배포 시 필수) -----
# 웹 UI(승인/수정/지식편집)는 자체 인증이 없어 기본은 localhost 전용.
# 공개 배포(Render 등)에서 쓰려면 WEB_UI_PASSWORD 설정 → 브라우저 Basic Auth 로그인.
# 비우면 localhost 전용 유지(로컬 개발).
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=                             # 강한 비밀번호 설정 (공개 URL에서 웹 UI 접근용)

# ----- Web UI 로그인 방식 -----
# basic         : 위 Basic Auth(또는 localhost). 기본값.
# google_oauth  : 구글 로그인 — ALLOWED_EMAIL_DOMAIN 도메인 + 아래 allowlist만 허용.
# 구글 자격증명을 채우기 전까지 basic 유지(배포 잠김 방지).
AUTH_MODE=basic
GOOGLE_OAUTH_CLIENT_ID=                       # Google Cloud → OAuth 2.0 웹 클라이언트 ID
GOOGLE_OAUTH_CLIENT_SECRET=                   # 같은 클라이언트의 시크릿
ALLOWED_EMAIL_DOMAIN=estsoft.com             # 이 도메인의 인증된 구글 계정만 로그인
WEB_UI_ADMIN_EMAILS=                          # 쉼표구분: 첫 로그인 시 자동 관리자·승인
WEB_UI_ALLOWED_EMAILS=                        # 쉼표구분: 관리자 승인 없이 사전 허용할 이메일
SESSION_SECRET=                               # 세션 쿠키 서명 키(랜덤 긴 문자열). google_oauth 시 필수
# 리디렉트 URI는 https://<배포URL>/auth/callback 를 Google 콘솔에 등록하세요.

# ----- Report distribution -----
REPORT_SLACK_CHANNEL_ID=                     # 보고서를 별도로 보낼 때만 설정; 승인 채널로 fallback 하지 않음
REPORT_EMAIL_TO=                             # comma-separated list, e.g. boss@co.com,team@co.com

# ----- Inbound poller (webhook 누락 방지 fallback) -----
INBOUND_POLL_ENABLED=true                    # 10분마다 HubSpot New Ticket 폴링 (webhook 백업)
INBOUND_POLL_INTERVAL_SECONDS=600            # 폴링 간격 (초)
INBOUND_AUTO_ACK_ENABLED=true                # 첫 문의 즉시 접수 확인 메일 발송

# ----- Send worker (background queue) -----
SEND_WORKER_ENABLED=true                     # 승인 후 동일 워커 경로로 발송
SEND_RATE_PER_MINUTE=5                       # 분당 최대 발송 건수
DAILY_SEND_LIMIT=400                         # 일일 최대 발송 건수 (0=무제한)
SEND_JITTER_SECONDS=15                       # 메일 사이 0~N초 랜덤 대기

# ----- Behavior knobs -----
AUTO_SEND_THRESHOLD=1.01                     # >1.0 means: never auto-send, always require human approval
DAILY_REPORT_HOUR=18                         # 24h clock, local time
WEEKLY_REPORT_DOW=5                          # 0=Mon, 5=Sat

# ----- Domain enrichment (인바운드 이메일 도메인 자동 분석) -----
INBOUND_DOMAIN_ENRICHMENT_ENABLED=true      # 인바운드 시 회사 도메인 자동 분석
INBOUND_DOMAIN_HOMEPAGE_FETCH=true           # false 면 홈페이지 fetch 생략, LLM-only 분석
INBOUND_DOMAIN_FETCH_TIMEOUT_SECONDS=5.0     # 홈페이지 GET 타임아웃 (초)
INBOUND_DOMAIN_REANALYZE_DAYS=90             # 이 일수 이상 오래된 프로파일 자동 재분석 후보

# ----- DB -----
DATABASE_URL=sqlite:///./data/app.db

# ----- App -----
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
INTERNAL_API_TOKEN=                            # 필수: 강한 랜덤 값으로 설정 (`python -c "import secrets; print(secrets.token_urlsafe(32))"`). 비어 있으면 API가 모든 요청을 거부합니다.
