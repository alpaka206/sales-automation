{
  "name": "07 Healthcheck",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "*/15 * * * *" }] } },
      "name": "Every 15 min",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BE_BASE_URL }}/internal/healthcheck",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}" }]
        },
        "options": {}
      },
      "name": "Run Healthcheck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.overall_status }}", "operation": "equals", "value2": "FAIL" }
          ]
        }
      },
      "name": "Has Failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_ERROR_CHANNEL_ID || $env.SLACK_APPROVAL_CHANNEL_ID }}",
        "text": "[Healthcheck FAIL] {{ $json.checks.filter(c => c.status === 'FAIL').map(c => c.name + ': ' + c.detail).join(', ') }}",
        "otherOptions": {}
      },
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1000, 200],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack" } }
    }
  ],
  "connections": {
    "Every 15 min": { "main": [[{ "node": "Run Healthcheck", "type": "main", "index": 0 }]] },
    "Run Healthcheck": { "main": [[{ "node": "Has Failures?", "type": "main", "index": 0 }]] },
    "Has Failures?": { "main": [[{ "node": "Slack Alert", "type": "main", "index": 0 }], []] }
  }
}
