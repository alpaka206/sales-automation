{
  "name": "01 Inbound Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hubspot-inbound",
        "responseMode": "responseNode"
      },
      "name": "HubSpot Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BE_BASE_URL }}/webhook/hubspot/inbound",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "event_type", "value": "={{ $json.event_type }}" },
            { "name": "object_id", "value": "={{ $json.object_id }}" },
            { "name": "occurred_at", "value": "={{ $json.occurred_at }}" }
          ]
        },
        "options": {}
      },
      "name": "Call BE Inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 550]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_ERROR_CHANNEL_ID || $env.SLACK_APPROVAL_CHANNEL_ID }}",
        "text": "[01 Inbound Webhook] 오류 발생: {{ $json.execution.error.message }}",
        "otherOptions": {}
      },
      "name": "Slack Error Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [500, 550],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack" } }
    }
  ],
  "connections": {
    "HubSpot Webhook": { "main": [[{ "node": "Call BE Inbound", "type": "main", "index": 0 }]] },
    "Call BE Inbound": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Slack Error Alert", "type": "main", "index": 0 }]] }
  }
}
